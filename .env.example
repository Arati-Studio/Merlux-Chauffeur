# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: The primary public URL for search engines.
VITE_SITE_URL="https://merlux.au"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps integration.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# VITE_FLIGHT_API_KEY: Required for AeroDataBox (RapidAPI) flight tracking.
VITE_FLIGHT_API_KEY="YOUR_FLIGHT_API_KEY"

# STRIPE_SECRET_KEY: Required for server-side Stripe Checkout.
STRIPE_SECRET_KEY="sk_test_..."
# VITE_STRIPE_PUBLISHABLE_KEY: Required for client-side Stripe integration.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email / SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="user@example.com"
TWILIO_ACCOUNT_SID="ACe1bad5da8fe057c63f12e3a60ab5e207"
TWILIO_AUTH_TOKEN="995310fdb5708418a324b8d416576d50"
TWILIO_PHONE_NUMBER="+61426444449"
